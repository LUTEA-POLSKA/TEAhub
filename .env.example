# TEAhub provider configuration.
#
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Keys live here and nowhere else — not in config files, not in the
# database, not in audit events.

# Which providers are enabled, in priority order (see docs/architecture-proposal.md
# section 7: the requirement ranking decides the order, this list is the
# candidate set). Comma-separated keys of PROVIDERS below.
#
# Test target for development: OpenRouter (decided by owner). One key, many
# models, standard /chat/completions. Ollama stays available as the zero-setup
# local fallback.
TEAHUB_PROVIDERS=openrouter,ollama

# --- Local provider (no key, no network egress) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- OpenAI-compatible cloud providers ---
# Any endpoint speaking /chat/completions works. One key per provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# --- ModelMesh ---
# Not yet available: mlhsm/ModelMesh has no /v1 endpoint (see docs/audit-step1.md).
# Uncomment once the OpenAI-compatible endpoint exists. TEAhub needs nothing
# MLHSM-specific for this to work — only a base URL and a key.
# MLHSM_BASE_URL=http://127.0.0.1:19090/v1
# MLHSM_API_KEY=

# --- Database ---
DATABASE_URL=postgres://teahub:teahub@127.0.0.1:5432/teahub