# TEAhub Environment Configuration
# Copy to .env and fill in values. Never commit .env!

# =============================================================================
# REQUIRED: Public origin (browser-facing). Must be https in production.
# =============================================================================
TEAHUB_PUBLIC_ORIGIN=https://teahub.example.com

# =============================================================================
# REQUIRED: Database
# =============================================================================
# For local development with PGlite: leave empty or use file:./teahub.db
# For production: postgresql://user:password@host:5432/teahub
DATABASE_URL=postgresql://teahub:changeme@postgres:5432/teahub

# Alternative: Postgres credentials (used by docker-compose)
POSTGRES_USER=teahub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=teahub

# =============================================================================
# REQUIRED: Provider configuration
# =============================================================================
# Comma-separated list of provider IDs. Order = fallback priority.
TEAHUB_PROVIDERS=openrouter,mlhsm

# OpenRouter (cloud, many models, free tier available)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ModelMesh (local, via MLHSM) - requires MLHSM running with /v1 endpoint
MLHSM_BASE_URL=http://host.docker.internal:19090/v1
MLHSM_API_KEY=changeme
MLHSM_MODEL=mlhsm-model

# Optional: per-provider overrides
# OPENROUTER_PRICE=0.15/0.60
# MLHSM_PRICE=0/0
# OPENROUTER_CONTEXT=128000
# MLHSM_CONTEXT=128000
# OPENROUTER_TOOLS=true
# MLHSM_TOOLS=true
# OPENROUTER_VISION=false
# MLHSM_VISION=false

# =============================================================================
# OPTIONAL: Workspace & Security
# =============================================================================
# Comma-separated absolute paths the filesystem tools may access
TEAHUB_WORKSPACE_ROOTS=/workspace,/data

# Comma-separated hosts web.fetch may call
TEAHUB_FETCH_HOSTS=api.github.com,raw.githubusercontent.com

# Policy file path
TEAHUB_POLICY_PATH=policy.json

# Session TTL (milliseconds)
TEAHUB_SESSION_TTL_MS=43200000

# =============================================================================
# WORKER SETTINGS
# =============================================================================
WORKER_INTERVAL_MS=1000

# =============================================================================
# APPLICATION PORT
# =============================================================================
TEAHUB_PORT=3000